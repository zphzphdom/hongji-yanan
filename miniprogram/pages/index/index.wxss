.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #FAF5EF;
}

/* 头部 */
.top {
  background: linear-gradient(160deg, #8C1F28, #6B1219 80%);
  padding: 24rpx 32rpx 0;
  color: #fff;
  flex: none;
}

.brand-row {
  display: flex;
  align-items: baseline;
}

.brand {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
}

.agent {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #F3D9B8;
  letter-spacing: 2rpx;
}

.meta {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #E9C9A6;
  opacity: 0.9;
}

.modes {
  display: flex;
  margin-top: 20rpx;
}

.mode {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: #F6E4CE;
  background: rgba(255, 255, 255, 0.10);
  border-radius: 12rpx 12rpx 0 0;
  margin-right: 8rpx;
}

.mode:last-child {
  margin-right: 0;
}

.mode.on {
  background: #FAF5EF;
  color: #8C1F28;
  font-weight: 600;
}

/* 对话区 */
.chat {
  flex: 1;
  padding: 28rpx 28rpx 0;
  box-sizing: border-box;
}

.intro {
  padding: 10rpx 4rpx 24rpx;
}

.intro-title {
  font-size: 38rpx;
  color: #8C1F28;
  font-weight: 700;
  line-height: 1.5;
}

.intro-sub {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #6E625C;
}

.msg {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
}

.msg.me {
  align-items: flex-end;
}

.bubble {
  max-width: 86%;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}

.bubble.me {
  background: #8C1F28;
  color: #fff;
  border-bottom-right-radius: 6rpx;
}

.bubble.ai {
  background: #fff;
  border: 2rpx solid #E7DCD3;
  border-bottom-left-radius: 6rpx;
  color: #211A17;
  max-width: 100%;
  width: 100%;
}

.bubble.ai.refused {
  border-left: 6rpx solid #B0863A;
  background: #FFFBF6;
}

.note {
  font-size: 20rpx;
  color: #B0863A;
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
}

.answer {
  font-size: 30rpx;
  line-height: 1.72;
  white-space: pre-wrap;
}

.loading {
  color: #B0863A;
  font-size: 26rpx;
}

.srcs {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 2rpx dashed #E7DCD3;
}

.src {
  font-size: 22rpx;
  color: #8C1F28;
  background: #F7EDE6;
  border: 2rpx solid #EAD7C8;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  margin: 0 12rpx 8rpx 0;
}

.acts {
  margin-top: 14rpx;
  display: flex;
}

.act {
  font-size: 24rpx;
  color: #6E625C;
  margin-right: 32rpx;
  border-bottom: 2rpx solid transparent;
}

.bottom-pad {
  height: 24rpx;
}

/* 快捷问题 */
.chips {
  padding: 8rpx 28rpx;
  display: flex;
  flex-wrap: nowrap;
  overflow-x: auto;
  white-space: nowrap;
  flex: none;
}

.chip {
  flex: none;
  font-size: 24rpx;
  color: #4A3A34;
  background: #fff;
  border: 2rpx solid #E7DCD3;
  border-radius: 24rpx;
  padding: 8rpx 20rpx;
  margin-right: 12rpx;
}

/* 输入 */
.composer {
  flex: none;
  display: flex;
  align-items: center;
  padding: 12rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #FAF5EF;
  border-top: 2rpx solid rgba(231, 220, 211, 0.8);
}

.input {
  flex: 1;
  background: #fff;
  border: 2rpx solid #E7DCD3;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  margin-right: 16rpx;
}

.send {
  background: #8C1F28;
  color: #fff;
  font-size: 28rpx;
  padding: 16rpx 32rpx;
  border-radius: 16rpx;
}

.send.off {
  opacity: 0.5;
}
