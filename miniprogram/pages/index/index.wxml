<view class="container">
  <view class="top">
    <view class="brand-row">
      <view class="brand">红迹·延安</view>
      <view class="agent">AI 讲解员 · 延小讲</view>
    </view>
    <view class="meta">{{meta}}</view>
    <view class="modes">
      <view class="mode {{mode==='fact'?'on':''}}" data-mode="fact" bindtap="setMode">史实问答</view>
      <view class="mode {{mode==='research'?'on':''}}" data-mode="research" bindtap="setMode">研学讲解词</view>
      <view class="mode {{mode==='moment'?'on':''}}" data-mode="moment" bindtap="setMode">一句话</view>
    </view>
  </view>

  <scroll-view class="chat" scroll-y scroll-into-view="{{anchor}}" scroll-with-animation>
    <view wx:if="{{messages.length===0}}" class="intro">
      <view class="intro-title">在延安，问一句有出处的话</view>
      <view class="intro-sub">我只答知识库里的 {{count}} 条史实，每条都标来源；没有的，我会直说“需要查证”。</view>
    </view>

    <view wx:for="{{messages}}" wx:key="index" id="m{{index}}" class="msg {{item.role}}">
      <view wx:if="{{item.role==='me'}}" class="bubble me">{{item.text}}</view>
      <view wx:else class="bubble ai {{item.refused?'refused':''}}">
        <view wx:if="{{item.note}}" class="note">{{item.note}}</view>
        <view wx:if="{{item.loading}}" class="loading">正在检索…</view>
        <text wx:else class="answer">{{item.text}}</text>

        <view wx:if="{{item.sources.length}}" class="srcs">
          <view wx:for="{{item.sources}}" wx:for-item="s" wx:key="id" class="src"
                data-src="{{s}}" bindtap="onSource">{{s.id}} · {{s.org}}</view>
        </view>

        <view wx:if="{{item.role==='ai' && !item.loading}}" class="acts">
          <block wx:if="{{!item.refused}}">
            <text class="act" data-i="{{index}}" bindtap="makeCard">生成问答卡</text>
            <text class="act" data-i="{{index}}" bindtap="copyText">复制文案</text>
          </block>
          <text wx:else class="act muted">不猜，就是这个回答</text>
        </view>
      </view>
    </view>
    <view class="bottom-pad"></view>
  </scroll-view>

  <view class="chips">
    <view wx:for="{{chips}}" wx:key="index" class="chip" data-q="{{item}}" bindtap="useChip">{{item}}</view>
  </view>

  <view class="composer">
    <input class="input" value="{{input}}" placeholder="问点什么，比如：宝塔山为什么是延安的象征？"
           confirm-type="send" bindinput="onInput" bindconfirm="send" />
    <view class="send {{sending?'off':''}}" bindtap="send">发送</view>
  </view>
</view>
